<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<section class="page-hero">
  <div class="wrap">
    <ol class="crumbs"><li><a href="/">Home</a></li><li>Contact</li></ol>
    <h1>Talk to a person.</h1>
    <p class="lede">Call, email, or send a message. We answer the same business day.</p>
  </div>
</section>
<section class="section">
  <div class="wrap two-col" style="grid-template-columns: .75fr 1.25fr">
    <div>
      <h2>Direct</h2>
      <p style="font-family:var(--font-display);font-size:1.5rem;font-weight:700;letter-spacing:-.02em;margin:0"><a href="<%= site.phoneHref %>" style="text-decoration:none"><%= site.phone %></a></p>
      <p><a href="mailto:<%= site.email %>"><%= site.email %></a></p>
      <p class="muted"><%= site.hours %></p>
      <h3 style="margin-top:2em">Brokers &amp; ISOs</h3>
      <p>Use the <a href="/brokers#submit">deal submission form</a> so your file lands with an underwriter directly.</p>
    </div>
    <% if (submitted) { %>
    <div class="notice">
      <h2>Message sent.</h2>
      <p>We will get back to you within the business day. If it is urgent, call <a href="<%= site.phoneHref %>"><%= site.phone %></a>.</p>
      <a class="btn btn-slate" href="/">Back to home</a>
    </div>
    <% } else { %>
    <form class="form-card" method="post" action="/contact">
      <div class="form-grid">
        <div><label for="c-name">Name</label><input type="text" id="c-name" name="full_name" required></div>
        <div><label for="c-business">Business</label><input type="text" id="c-business" name="business_name"></div>
        <div><label for="c-phone">Phone</label><input type="tel" id="c-phone" name="phone"></div>
        <div><label for="c-email">Email</label><input type="email" id="c-email" name="email" required></div>
        <div class="full"><label for="c-msg">Message</label><textarea id="c-msg" name="message" required></textarea></div>
        <div class="hp"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
        <div class="full"><button class="btn btn-brass btn-lg btn-block" type="submit">Send message</button></div>
      </div>
    </form>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
